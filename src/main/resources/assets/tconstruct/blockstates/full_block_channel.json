{
  "multipart": [
    { "apply": { "model": "tconstruct:block/foundry/scorched/bricks_slab" } },

    {   "when": { "north": "in" },
      "apply": { "model": "tconstruct:block/foundry/channel/side_in", "uvlock": true }
    },
    {   "when": { "north": "out" },
      "apply": { "model": "tconstruct:block/foundry/channel/side_out", "uvlock": true }
    },

    {   "when": { "east": "in" },
      "apply": { "model": "tconstruct:block/foundry/channel/side_in", "y": 90, "uvlock": true }
    },
    {   "when": { "east": "out" },
      "apply": { "model": "tconstruct:block/foundry/channel/side_out", "y": 90, "uvlock": true }
    },

    {   "when": { "south": "in" },
      "apply": { "model": "tconstruct:block/foundry/channel/side_in", "y": 180, "uvlock": true }
    },
    {   "when": { "south": "out" },
      "apply": { "model": "tconstruct:block/foundry/channel/side_out", "y": 180, "uvlock": true }
    },

    {   "when": { "west": "in" },
      "apply": { "model": "tconstruct:block/foundry/channel/side_in", "y": 270, "uvlock": true }
    },
    {   "when": { "west": "out" },
      "apply": { "model": "tconstruct:block/foundry/channel/side_out", "y": 270, "uvlock": true }
    }
  ]
}
