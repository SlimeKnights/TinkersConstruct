{
    "multipart": [
        { "apply": { "model": "tconstruct:block/template/channel/slab_base" } },

        {   "when": { "north": "none" },
            "apply": { "model": "tconstruct:block/template/channel/slab_side_closed", "y": 90, "uvlock": true }
        },
      {   "when": {"north": "in"},
        "apply": { "model": "tconstruct:block/template/channel/slab_side_in", "y": 90, "uvlock": true }
      },
      {   "when": {"north": "out"},
        "apply": { "model": "tconstruct:block/template/channel/slab_side_out", "y": 90, "uvlock": true }
      },
        
        {   "when": { "east": "none" },
          "apply": { "model": "tconstruct:block/template/channel/slab_side_closed", "y": 180, "uvlock": true }
        },
        {   "when": {"east": "in"},
          "apply": { "model": "tconstruct:block/template/channel/slab_side_in", "y": 180, "uvlock": true }
        },
        {   "when": {"east": "out"},
          "apply": { "model": "tconstruct:block/template/channel/slab_side_out", "y": 180, "uvlock": true }
        },
        
        {   "when": { "south": "none" },
          "apply": { "model": "tconstruct:block/template/channel/slab_side_closed", "y": 270, "uvlock": true }
        },
      {   "when": {"south": "in"},
        "apply": { "model": "tconstruct:block/template/channel/slab_side_in", "y": 270, "uvlock": true }
      },
      {   "when": {"south": "out"},
        "apply": { "model": "tconstruct:block/template/channel/slab_side_out", "y": 270, "uvlock": true }
      },
        
        {   "when": { "west": "none" },
          "apply": { "model": "tconstruct:block/template/channel/slab_side_closed", "uvlock": true }
        },
      {   "when": {"west": "in"},
        "apply": { "model": "tconstruct:block/template/channel/slab_side_in", "uvlock": true }
      },
      {   "when": {"west": "out"},
        "apply": { "model": "tconstruct:block/template/channel/slab_side_out", "uvlock": true }
      }
    ]
}
